    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
